# Copie para .env (que é ignorado pelo Git) e preencha o que quiser.
# Nada aqui é obrigatório: sem chave, o worker usa o FakeLlmProvider.

# --- IA ---------------------------------------------------------------
# Chave gratuita do Gemini, criada num projeto SEM faturamento ativado
# (veja "Chave gratuita do Gemini" no README). Nunca cole esta chave em
# chat, issue ou commit.
GEMINI_API_KEY=
# gemini | ollama | fake
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Usado só com o perfil "ollama" do docker compose.
OLLAMA_MODEL=qwen2.5:1.5b

# --- Segredos do servidor ---------------------------------------------
# Em desenvolvimento estes valores vão para o Secrets Manager do LocalStack.
# Troque por textos longos e aleatórios em qualquer ambiente real.
JWT_SECRET=dev-only-jwt-secret-change-me
BYOK_ENCRYPTION_KEY=dev-only-byok-key-change-me

# --- Limites de custo de IA (worker) ----------------------------------
# Respostas da IA por partida (por IA).
AI_MAX_REPLIES_PER_MATCH=40
# Tamanho máximo de cada resposta, em tokens.
AI_MAX_OUTPUT_TOKENS=80
# Quantas mensagens recentes vão como contexto no prompt.
AI_CONTEXT_MESSAGES=12
# Disjuntor diário (todas as salas juntas, chave do servidor).
AI_DAILY_MAX_CALLS=400
AI_DAILY_MAX_TOKENS=400000

# --- Limites da API ----------------------------------------------------
MAX_MATCHES_PER_ROOM_PER_DAY=30
# Requisições REST por minuto por IP (criar/entrar em sala, upload).
RATE_LIMIT_PER_MINUTE=60
